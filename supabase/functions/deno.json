{
  "tasks": {
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "typecheck": "deno check ./*/index.ts",
    "test": "deno test --permit-no-files --allow-env --allow-net",
    "check": "deno fmt --check && deno lint && deno check ./*/index.ts && deno test --permit-no-files --allow-env --allow-net"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
